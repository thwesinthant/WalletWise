<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_header_bg"
    tools:context=".transactions.AddTransactionActivity">

    <!-- ========================================================= -->
    <!-- BACK BUTTON -->
    <!-- ========================================================= -->

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/circle_bg_white"
        android:contentDescription="Back"
        android:padding="8dp"
        android:src="@drawable/baseline_arrow_back_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- ========================================================= -->
    <!-- TITLE -->
    <!-- ========================================================= -->

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Expense"
        android:textColor="@color/primary_900"
        android:textSize="20sp"
        android:fontFamily="@font/dosis_extrabold"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack" />


    <!-- ========================================================= -->
    <!-- EXPENSE / INCOME / TRANSFER SELECTOR -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/typeSelector"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/selector_bg"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack">

        <TextView
            android:id="@+id/tvExpense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/selector_selected_bg"
            android:fontFamily="@font/dosis_semibold"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:text="Expense"
            android:textColor="@color/neutral_0"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvIncome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/dosis_semibold"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:text="Income"
            android:textColor="@color/neutral_500"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvTransfer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/dosis_semibold"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:text="Transfer"
            android:textColor="@color/neutral_500"
            android:textSize="16sp" />

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- AMOUNT -->
    <!-- ========================================================= -->

    <TextView
        android:id="@+id/tvAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/dosis_extrabold"
        android:text="MMK 0"
        android:textColor="@color/primary_900"
        android:textSize="40sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/typeSelector" />

    <TextView
        android:id="@+id/tvAmountLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/molengo_regular"
        android:text="Enter Amount"
        android:textColor="@color/neutral_500"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAmount" />


    <!-- ========================================================= -->
    <!-- SELECTED CATEGORY -->
    <!-- ========================================================= -->

    <TextView
        android:id="@+id/tvSelectedCategory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:fontFamily="@font/molengo_regular"
        android:text="No category selected"
        android:textColor="@color/neutral_500"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAmountLabel" />


    <!-- ========================================================= -->
    <!-- CATEGORY CHIPS -->
    <!-- ========================================================= -->

    <HorizontalScrollView
        android:id="@+id/categoryScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSelectedCategory">

        <LinearLayout
            android:id="@+id/categoryChipContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingEnd="20dp" />

    </HorizontalScrollView>


    <!-- ========================================================= -->
    <!-- NOTE -->
    <!-- ========================================================= -->

    <EditText
        android:id="@+id/etNote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/chip_bg"
        android:hint="Add a note (optional)"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="@color/primary_900"
        android:textColorHint="@color/neutral_500"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/categoryScroll" />


    <!-- PAYMENT METHOD / SOURCE ACCOUNT ROW -->
    <HorizontalScrollView
        android:id="@+id/paymentScroll"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@id/etNote"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/paymentChipContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingEnd="20dp" />

    </HorizontalScrollView>


    <!-- TRANSFER DESTINATION LABEL -->
    <TextView
        android:id="@+id/tvDestinationLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="10dp"
        android:text="Transfer To"
        android:textSize="13sp"
        android:fontFamily="@font/molengo_regular"
        android:textColor="@color/neutral_500"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/paymentScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- DESTINATION ACCOUNT -->
    <HorizontalScrollView
        android:id="@+id/destinationAccountScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvDestinationLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/destinationAccountChipContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingEnd="20dp" />

    </HorizontalScrollView>


    <!-- ========================================================= -->
    <!-- ADD / UPDATE BUTTON -->
    <!-- ========================================================= -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAdd"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:fontFamily="@font/dosis_extrabold"
        android:text="Add Expense"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:cornerRadius="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/destinationAccountScroll" />


    <!-- ========================================================= -->
    <!-- KEYPAD -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/keypadArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="@color/neutral_0"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnAdd">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:paddingBottom="3dp"
            android:rowCount="4">

            <!-- ================================================= -->
            <!-- ROW 1 -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/key1"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:background="@drawable/key_bg"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:outlineProvider="background">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dosis_extrabold"
                    android:text="1"
                    android:textColor="@color/primary_600"
                    android:textSize="21sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/key2"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:background="@drawable/key_bg"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:outlineProvider="background">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dosis_extrabold"
                    android:text="2"
                    android:textColor="@color/primary_600"
                    android:textSize="21sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/molengo_regular"
                    android:text="ABC"
                    android:textColor="@color/neutral_500"
                    android:textSize="8sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/key3"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:background="@drawable/key_bg"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:outlineProvider="background">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dosis_extrabold"
                    android:text="3"
                    android:textColor="@color/primary_600"
                    android:textSize="21sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/molengo_regular"
                    android:text="DEF"
                    android:textColor="@color/neutral_500"
                    android:textSize="8sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- ROW 2 -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/key4"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:background="@drawable/key_bg"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:outlineProvider="background">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dosis_extrabold"
                    android:text="4"
                    android:textColor="@color/primary_600"
                    android:textSize="21sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/molengo_regular"
                    android:text="GHI"
                    android:textColor="@color/neutral_500"
                    android:textSize="8sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/key5"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:background="@drawable/key_bg"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:outlineProvider="background">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dosis_extrabold"
                    android:text="5"
                    android:textColor="@color/primary_600"
                    android:textSize="21sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/molengo_regular"
                    android:text="JKL"
                    android:textColor="@color/neutral_500"
                    android:textSize="8sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/key6"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:background="@drawable/key_bg"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:outlineProvider="background">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dosis_extrabold"
                    android:text="6"
                    android:textColor="@color/primary_600"
                    android:textSize="21sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/molengo_regular"
                    android:text="MNO"
                    android:textColor="@color/neutral_500"
                    android:textSize="8sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- ROW 3 -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/key7"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:background="@drawable/key_bg"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:outlineProvider="background">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dosis_extrabold"
                    android:text="7"
                    android:textColor="@color/primary_600"
                    android:textSize="21sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/molengo_regular"
                    android:text="PQRS"
                    android:textColor="@color/neutral_500"
                    android:textSize="8sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/key8"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:background="@drawable/key_bg"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:outlineProvider="background">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dosis_extrabold"
                    android:text="8"
                    android:textColor="@color/primary_600"
                    android:textSize="21sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/molengo_regular"
                    android:text="TUV"
                    android:textColor="@color/neutral_500"
                    android:textSize="8sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/key9"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:background="@drawable/key_bg"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:outlineProvider="background">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dosis_extrabold"
                    android:text="9"
                    android:textColor="@color/primary_600"
                    android:textSize="21sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/molengo_regular"
                    android:text="WXYZ"
                    android:textColor="@color/neutral_500"
                    android:textSize="8sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- ROW 4 -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/keyDot"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:background="@drawable/key_bg"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:outlineProvider="background">

                <TextView
                    android:id="@+id/keyDotText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dosis_extrabold"
                    android:text="."
                    android:textColor="@color/primary_600"
                    android:textSize="21sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/key0"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:background="@drawable/key_bg"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:outlineProvider="background">

                <TextView
                    android:id="@+id/key0Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dosis_extrabold"
                    android:text="0"
                    android:textColor="@color/primary_600"
                    android:textSize="21sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/keyDel"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:background="@drawable/key_bg"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:outlineProvider="background">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:contentDescription="Delete"
                    android:src="@drawable/ic_backspace" />

            </LinearLayout>

        </GridLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>