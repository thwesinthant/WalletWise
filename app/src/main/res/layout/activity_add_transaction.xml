<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_header_bg"
    tools:context=".transactions.AddTransactionActivity">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="8dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/circle_bg_white"
        android:src="@drawable/baseline_arrow_back_24"
        android:contentDescription="Back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Expense"
        android:fontFamily="@font/dosis_extrabold"
        android:textSize="20sp"
        android:textColor="@color/primary_900"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/typeSelector"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="28dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/selector_bg"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvExpense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Expenses"
            android:fontFamily="@font/dosis_semibold"
            android:textSize="16sp"
            android:textColor="@color/neutral_0"
            android:background="@drawable/selector_selected_bg"
            android:paddingVertical="12dp" />

        <TextView
            android:id="@+id/tvIncome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Income"
            android:fontFamily="@font/dosis_semibold"
            android:textSize="16sp"
            android:textColor="@color/neutral_500"
            android:paddingVertical="12dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$0"
        android:fontFamily="@font/dosis_extrabold"
        android:textSize="40sp"
        android:textColor="@color/primary_900"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/typeSelector"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvAmountLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter Amount"
        android:fontFamily="@font/molengo_regular"
        android:textSize="13sp"
        android:textColor="@color/neutral_500"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvAmount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- SELECTED CATEGORY TEXT -->
    <TextView
        android:id="@+id/tvSelectedCategory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/molengo_regular"
        android:text="No category selected"
        android:textColor="@color/neutral_500"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/tvAmountLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- CATEGORY ROW -->
    <HorizontalScrollView
        android:id="@+id/categoryScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="20dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/tvSelectedCategory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/categoryChipContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingEnd="20dp" />

    </HorizontalScrollView>

    <!-- NOTE FIELD -->
    <EditText
        android:id="@+id/etNote"
        android:background="@drawable/chip_bg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Add a note (optional)"
        android:textSize="14sp"
        android:textColorHint="@color/neutral_500"
        android:textColor="@color/primary_900"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:maxLines="1"
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@id/categoryScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- PAYMENT METHOD ROW -->
    <HorizontalScrollView
        android:id="@+id/paymentScroll"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@id/etNote"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/paymentChipContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingEnd="20dp" />

    </HorizontalScrollView>


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAdd"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="Add Expense"
        android:textAllCaps="false"
        android:fontFamily="@font/dosis_extrabold"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="12dp"
        app:cornerRadius="25dp"
        app:layout_constraintTop_toBottomOf="@id/paymentScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- KEYPAD -->
    <LinearLayout
        android:id="@+id/keypadArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@color/neutral_0"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnAdd"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="4">

            <!-- Row 1 -->
            <LinearLayout android:id="@+id/key1" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:layout_margin="6dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/key_bg" android:elevation="3dp" android:outlineProvider="background">
                <TextView android:text="1" android:fontFamily="@font/dosis_extrabold" android:textSize="24sp" android:textColor="@color/primary_600" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:id="@+id/key2" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:layout_margin="6dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/key_bg" android:elevation="3dp" android:outlineProvider="background">
                <TextView android:text="2" android:fontFamily="@font/dosis_extrabold" android:textSize="24sp" android:textColor="@color/primary_600" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:text="ABC" android:fontFamily="@font/molengo_regular" android:textSize="10sp" android:textColor="@color/neutral_500" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:id="@+id/key3" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:layout_margin="6dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/key_bg" android:elevation="3dp" android:outlineProvider="background">
                <TextView android:text="3" android:fontFamily="@font/dosis_extrabold" android:textSize="24sp" android:textColor="@color/primary_600" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:text="DEF" android:fontFamily="@font/molengo_regular" android:textSize="10sp" android:textColor="@color/neutral_500" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout android:id="@+id/key4" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:layout_margin="6dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/key_bg" android:elevation="3dp" android:outlineProvider="background">
                <TextView android:text="4" android:fontFamily="@font/dosis_extrabold" android:textSize="24sp" android:textColor="@color/primary_600" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:text="GHI" android:fontFamily="@font/molengo_regular" android:textSize="10sp" android:textColor="@color/neutral_500" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:id="@+id/key5" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:layout_margin="6dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/key_bg" android:elevation="3dp" android:outlineProvider="background">
                <TextView android:text="5" android:fontFamily="@font/dosis_extrabold" android:textSize="24sp" android:textColor="@color/primary_600" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:text="JKL" android:fontFamily="@font/molengo_regular" android:textSize="10sp" android:textColor="@color/neutral_500" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:id="@+id/key6" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:layout_margin="6dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/key_bg" android:elevation="3dp" android:outlineProvider="background">
                <TextView android:text="6" android:fontFamily="@font/dosis_extrabold" android:textSize="24sp" android:textColor="@color/primary_600" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:text="MNO" android:fontFamily="@font/molengo_regular" android:textSize="10sp" android:textColor="@color/neutral_500" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Row 3 -->
            <LinearLayout android:id="@+id/key7" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:layout_margin="6dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/key_bg" android:elevation="3dp" android:outlineProvider="background">
                <TextView android:text="7" android:fontFamily="@font/dosis_extrabold" android:textSize="24sp" android:textColor="@color/primary_600" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:text="PQRS" android:fontFamily="@font/molengo_regular" android:textSize="10sp" android:textColor="@color/neutral_500" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:id="@+id/key8" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:layout_margin="6dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/key_bg" android:elevation="3dp" android:outlineProvider="background">
                <TextView android:text="8" android:fontFamily="@font/dosis_extrabold" android:textSize="24sp" android:textColor="@color/primary_600" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:text="TUV" android:fontFamily="@font/molengo_regular" android:textSize="10sp" android:textColor="@color/neutral_500" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:id="@+id/key9" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:layout_margin="6dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/key_bg" android:elevation="3dp" android:outlineProvider="background">
                <TextView android:text="9" android:fontFamily="@font/dosis_extrabold" android:textSize="24sp" android:textColor="@color/primary_600" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:text="WXYZ" android:fontFamily="@font/molengo_regular" android:textSize="10sp" android:textColor="@color/neutral_500" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Row 4 -->
            <LinearLayout android:id="@+id/keyDot" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:layout_margin="6dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/key_bg" android:elevation="3dp" android:outlineProvider="background">
                <TextView android:id="@+id/keyDotText" android:text="." android:fontFamily="@font/dosis_extrabold" android:textSize="24sp" android:textColor="@color/primary_600" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:id="@+id/key0" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:layout_margin="6dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/key_bg" android:elevation="3dp" android:outlineProvider="background">
                <TextView android:id="@+id/key0Text" android:text="0" android:fontFamily="@font/dosis_extrabold" android:textSize="24sp" android:textColor="@color/primary_600" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:id="@+id/keyDel" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:layout_margin="6dp" android:gravity="center" android:background="@drawable/key_bg" android:elevation="3dp" android:outlineProvider="background">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_backspace"
                    android:contentDescription="Delete" />
            </LinearLayout>
        </GridLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>