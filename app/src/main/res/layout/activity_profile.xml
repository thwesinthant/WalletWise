<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_header_bg">

    <!-- =========================================================
         FIXED TOP NAVIGATION
         ========================================================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topNav"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="20dp"
            android:padding="8dp"
            android:background="@drawable/circle_bg_white"
            android:src="@drawable/baseline_arrow_back_24"
            android:contentDescription="Back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:fontFamily="@font/dosis_extrabold"
            android:textSize="20sp"
            android:textColor="@color/primary_900"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            app:layout_constraintBottom_toBottomOf="@id/btnBack" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- =========================================================
         SCROLLABLE CONTENT
         ========================================================= -->

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/topNav"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="24dp">

            <!-- Purple header card -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
               android:padding="20dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/avatarFrame"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_centerHorizontal="true"
                    app:cardCornerRadius="36dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#D9D9E3">

                    <ImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="18dp"
                        android:src="@drawable/ic_person"
                        app:tint="#8A8A9E" />

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/avatarFrame"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="12dp"
                    android:text="Hi!"
                    android:textColor="@color/background_dark"
                    android:fontFamily="@font/dosis_bold"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnEditPhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvGreeting"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_white_pill"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="8dp"
                    android:text="Edit profile photo"
                    android:fontFamily="@font/molengo_regular"
                    android:textColor="@color/primary_500"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <!-- Personal Information -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Personal Information"
                android:textColor="@color/text_primary_light"
                android:fontFamily="@font/dosis_bold"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Name row -->

            <LinearLayout
                android:id="@+id/rowName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingVertical="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="13dp"
                    android:fontFamily="@font/molengo_regular"
                    android:text="Name"
                    android:textColor="@color/primary_600"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvNameValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:layout_marginEnd="8dp"
                    android:fontFamily="@font/molengo_regular"
                    android:textColor="@color/text_secondary_light"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right" />

            </LinearLayout>

            <!-- Currency row -->

            <LinearLayout
                android:id="@+id/rowCurrency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingVertical="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Currency"
                    android:fontFamily="@font/molengo_regular"
                    android:textColor="@color/primary_600"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvCurrencyValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:layout_marginEnd="8dp"
                    android:fontFamily="@font/molengo_regular"
                    android:textColor="@color/text_secondary_light"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right" />

            </LinearLayout>

            <!-- Sign In -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Sign In"
                android:textColor="@color/text_primary_light"
                android:fontFamily="@font/dosis_bold"
                android:textSize="18sp" />

            <!-- Email -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:fontFamily="@font/molengo_regular"
                    android:textColor="@color/primary_600"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvEmailValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:layout_marginEnd="8dp"
                    android:fontFamily="@font/molengo_regular"
                    android:textColor="@color/text_secondary_light"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Manage Account -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Manage Account"
                android:textColor="@color/text_primary_light"
                android:fontFamily="@font/dosis_bold"
                android:textSize="18sp" />

            <!-- Change Password -->

            <LinearLayout
                android:id="@+id/rowChangePassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingVertical="14dp">

                <TextView
                    android:id="@+id/tvChangePassword"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Change Password"
                    android:fontFamily="@font/molengo_regular"
                    android:textColor="@color/primary_600"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right" />

            </LinearLayout>

            <!-- Log Out -->

            <TextView
                android:id="@+id/tvLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingVertical="10dp"
                android:text="Log Out"
                android:fontFamily="@font/molengo_regular"
                android:textColor="@color/primary_600"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />


        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- =========================================================
         FIXED BOTTOM NAVIGATION
         ========================================================= -->

    <!-- Bottom nav -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="82dp"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="12dp"
        android:translationZ="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <include layout="@layout/layout_bottom_nav" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

