<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/budgetCard"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginBottom="12dp"

    app:cardBackgroundColor="@color/neutral_0"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"

    app:strokeColor="@color/neutral_100"
    app:strokeWidth="1dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:padding="17dp">


        <!-- ===================================================== -->
        <!-- NAME + STATUS -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="center_vertical"
            android:orientation="horizontal">


            <!-- NAME + DATE -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:id="@+id/tvBudgetName"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:fontFamily="@font/dosis_bold"
                    android:textColor="@color/neutral_900"
                    android:textSize="17sp" />


                <TextView
                    android:id="@+id/tvBudgetDate"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="2dp"

                    android:fontFamily="@font/dosis_medium"
                    android:textColor="@color/neutral_500"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- STATUS -->

            <TextView
                android:id="@+id/tvBudgetStatus"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"

                android:text="Active"

                android:fontFamily="@font/dosis_semibold"
                android:textColor="@color/primary_500"
                android:textSize="10sp"

                android:background="@drawable/bg_active_budget" />

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- TOTAL AMOUNT -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/tvBudgetAmount"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="16dp"

            android:fontFamily="@font/dosis_extrabold"
            android:textColor="@color/neutral_900"
            android:textSize="24sp" />


        <!-- ===================================================== -->
        <!-- OVERALL PROGRESS -->
        <!-- ===================================================== -->

        <ProgressBar
            android:id="@+id/budgetProgress"

            style="?android:attr/progressBarStyleHorizontal"

            android:layout_width="match_parent"
            android:layout_height="7dp"

            android:layout_marginTop="10dp"

            android:max="100"
            android:progress="0"

            android:progressTint="@color/primary_500"
            android:backgroundTint="@color/primary_100" />


        <!-- ===================================================== -->
        <!-- SPENT + REMAINING -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="7dp"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/tvSpent"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:fontFamily="@font/dosis_medium"
                android:textColor="@color/neutral_500"
                android:textSize="11sp" />


            <TextView
                android:id="@+id/tvBudgetRemaining"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:fontFamily="@font/dosis_semibold"
                android:textColor="@color/income_green"
                android:textSize="11sp" />

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- CATEGORY DETAILS TOGGLE -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/btnToggleCategories"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="12dp"

            android:paddingTop="4dp"
            android:paddingBottom="4dp"

            android:text="Show category details ▼"

            android:fontFamily="@font/dosis_semibold"
            android:textColor="@color/primary_500"
            android:textSize="12sp"

            android:clickable="true"
            android:focusable="true"
            android:background="@android:color/transparent"

            android:visibility="gone" />


        <!-- ===================================================== -->
        <!-- DYNAMIC CATEGORY SUMMARY -->
        <!-- ===================================================== -->

        <LinearLayout
            android:id="@+id/categorySummary"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="2dp"

            android:orientation="vertical"

            android:visibility="gone" />


        <!-- ===================================================== -->
        <!-- EDIT + DELETE -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="15dp"

            android:gravity="end"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/btnEditBudget"

                android:layout_width="wrap_content"
                android:layout_height="36dp"

                android:gravity="center"

                android:paddingStart="16dp"
                android:paddingEnd="16dp"

                android:text="Edit"

                android:fontFamily="@font/dosis_semibold"
                android:textColor="@color/primary_500"
                android:textSize="12sp"

                android:background="@drawable/bg_actions_card"

                android:clickable="true"
                android:focusable="true" />


            <TextView
                android:id="@+id/btnDeleteBudget"

                android:layout_width="wrap_content"
                android:layout_height="36dp"

                android:layout_marginStart="8dp"

                android:gravity="center"

                android:paddingStart="16dp"
                android:paddingEnd="16dp"

                android:text="Delete"

                android:fontFamily="@font/dosis_semibold"
                android:textColor="@color/expense_red"
                android:textSize="12sp"

                android:background="@drawable/bg_actions_card"

                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>