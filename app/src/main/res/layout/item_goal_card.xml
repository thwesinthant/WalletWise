<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#F6FAFB"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Text + progress column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGoalTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Car"
                android:textColor="#4A90D9"
                android:textSize="18dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGoalTarget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="8000 MMK"

                android:textSize="16sp"
                android:textColor="#808080"/>

            <ProgressBar
                android:id="@+id/progressGoal"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="33"
                android:progressTint="#4A90D9"
                android:progressBackgroundTint="#DDE3EA" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvGoalAmounts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="4250 MMK / 8000 MMK"
                    android:textColor="#404040"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvGoalPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="33%"
                    android:textColor="#404040"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Piggy bank image is a BUTTON, not decoration.
             Tapping it should trigger an action, e.g. "add money to this goal". -->
        <ImageButton
            android:id="@+id/btnPiggyBank"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginStart="12dp"
            android:background="#F3F7FA"
            android:padding="8dp"
            android:scaleType="centerCrop"
            android:src="@drawable/outline_add_24"
            android:contentDescription="Add money to goal" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
