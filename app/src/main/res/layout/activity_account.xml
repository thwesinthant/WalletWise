<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_header_bg"
    android:fitsSystemWindows="true">

    <!-- Main content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollAccounts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="22dp"
            android:paddingBottom="30dp">

            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="30dp">

                <!-- Reusable Back Button -->
                <include
                    android:id="@+id/btnBack"
                    layout="@layout/view_back_button"
                    android:layout_width="36dp"
                    android:layout_height="36dp" />

                <!-- Title -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Accounts"
                    android:fontFamily="@font/dosis_extrabold"
                    android:textColor="@color/neutral_900"
                    android:textSize="21sp" />

                <!-- Add -->
                <TextView
                    android:id="@+id/btnAddAccount"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/neutral_0"
                    android:textSize="23sp"
                    android:fontFamily="@font/dosis_extrabold"
                    android:background="@drawable/bg_fab_add"
                    android:clickable="true"
                    android:focusable="true"
                    android:elevation="3dp"
                    android:contentDescription="Add account" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- SECTION TITLE -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Accounts"
                android:fontFamily="@font/dosis_extrabold"
                android:textColor="@color/neutral_900"
                android:textSize="19sp" />

            <!-- Number + total -->
            <TextView
                android:id="@+id/tvAccountSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/dosis_semibold"
                android:text="0 accounts · MMK 0.00"
                android:textColor="@color/neutral_700"
                android:textSize="12sp" />

            <!-- ================================================= -->
            <!-- ACCOUNTS LIST -->
            <!-- ================================================= -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAccounts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/emptyAccountState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="60dp"
                android:paddingBottom="40dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💳"
                    android:textSize="38sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="No accounts yet"
                    android:fontFamily="@font/dosis_extrabold"
                    android:textColor="@color/neutral_900"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Add your first cash or bank account"
                    android:fontFamily="@font/molengo_regular"
                    android:textColor="@color/neutral_500"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>