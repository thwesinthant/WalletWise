<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@drawable/gradient_header_bg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/btnBack"

        android:layout_width="36dp"
        android:layout_height="36dp"

        android:layout_marginStart="20dp"
        android:layout_marginTop="54dp"

        android:padding="8dp"

        android:background="@drawable/circle_bg_white"
        android:src="@drawable/baseline_arrow_back_24"
        android:contentDescription="Back"

        android:clickable="true"
        android:focusable="true"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- ===================================================== -->
    <!-- PAGE TITLE -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/tvBudgetPageTitle"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="Add Budget"

        android:fontFamily="@font/dosis_extrabold"
        android:textColor="@color/primary_900"
        android:textSize="20sp"

        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- SCROLLABLE CONTENT -->
    <!-- ===================================================== -->

    <ScrollView
        android:id="@+id/budgetScrollView"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:layout_marginTop="24dp"

        android:fillViewport="true"
        android:clipChildren="false"
        android:clipToPadding="false"

        android:scrollbars="none"

        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp">


            <!-- ================================================= -->
            <!-- INTRO -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvBudgetPageSubtitle"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="4dp"

                android:text="Create a new spending plan"

                android:fontFamily="@font/dosis_bold"
                android:textColor="@color/neutral_500"
                android:textSize="13sp" />


            <!-- ================================================= -->
            <!-- BUDGET NAME -->
            <!-- ================================================= -->

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MoneyMate.TextInputLayout"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="18dp"

                android:hint="Budget Name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBudgetName"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:inputType="textCapSentences"

                    android:fontFamily="@font/dosis_bold"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ================================================= -->
            <!-- TOTAL BUDGET AMOUNT -->
            <!-- ================================================= -->

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MoneyMate.TextInputLayout"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="14dp"

                android:hint="Budget Amount"

                app:prefixText="MMK ">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBudgetAmount"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:inputType="numberDecimal"

                    android:fontFamily="@font/dosis_bold"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ================================================= -->
            <!-- START DATE -->
            <!-- ================================================= -->

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MoneyMate.TextInputLayout"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="14dp"

                android:hint="Start Date">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etStartDate"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:focusable="false"
                    android:clickable="true"

                    android:fontFamily="@font/dosis_bold"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ================================================= -->
            <!-- END DATE -->
            <!-- ================================================= -->

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MoneyMate.TextInputLayout"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="14dp"

                android:hint="End Date">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEndDate"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:focusable="false"
                    android:clickable="true"

                    android:fontFamily="@font/dosis_bold"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ================================================= -->
            <!-- BUDGET CATEGORIES -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvCategoriesTitle"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="25dp"

                android:text="Budget Categories"

                android:fontFamily="@font/dosis_bold"
                android:textColor="@color/text_primary_light"
                android:textSize="18sp" />


            <TextView
                android:id="@+id/tvCategoriesSubtitle"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="3dp"

                android:text="Optional — divide your budget by category"

                android:fontFamily="@font/dosis_bold"
                android:textColor="@color/neutral_500"
                android:textSize="12sp" />


            <!-- ================================================= -->
            <!-- DYNAMIC CATEGORY ROWS -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/categoryContainer"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="14dp"

                android:orientation="vertical" />


            <!-- ================================================= -->
            <!-- ADD CATEGORY -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/btnAddCategory"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="12dp"

                android:text="+ Add Category"
                android:textAllCaps="false"

                android:fontFamily="@font/dosis_bold"
                android:textColor="@color/primary_500"

                android:backgroundTint="@color/primary_50" />


            <!-- ================================================= -->
            <!-- CREATE / UPDATE BUDGET -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/btnCreateBudget"

                style="@style/Widget.MoneyMate.Button.Primary"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="25dp"

                android:text="Create Budget" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

