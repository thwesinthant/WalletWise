<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background_light"
    android:fillViewport="true">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:padding="20dp">


        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnBack"

                android:layout_width="44dp"
                android:layout_height="44dp"

                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:contentDescription="Back" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="8dp"

                android:text="Add Budget"

                android:fontFamily="@font/dosis_bold"
                android:textColor="@color/text_primary_light"
                android:textSize="24sp" />

        </LinearLayout>


        <!-- INTRO -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="25dp"

            android:text="Create a new spending plan"

            android:fontFamily="@font/dosis_bold"
            android:textColor="@color/neutral_500"
            android:textSize="13sp" />


        <!-- BUDGET NAME -->

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MoneyMate.TextInputLayout"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="18dp"

            android:hint="Budget Name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBudgetName"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:fontFamily="@font/dosis_bold"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- AMOUNT -->

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MoneyMate.TextInputLayout"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="14dp"

            android:hint="Budget Amount">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBudgetAmount"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:inputType="numberDecimal"

                android:fontFamily="@font/dosis_bold"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- START DATE -->

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MoneyMate.TextInputLayout"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="14dp"

            android:hint="Start Date">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etStartDate"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:focusable="false"

                android:text="August 01, 2026"

                android:fontFamily="@font/dosis_bold"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- END DATE -->

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MoneyMate.TextInputLayout"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="14dp"

            android:hint="End Date">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEndDate"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:focusable="false"

                android:text="August 31, 2026"

                android:fontFamily="@font/dosis_bold"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- CATEGORIES -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="25dp"

            android:text="Budget Categories"

            android:fontFamily="@font/dosis_bold"
            android:textColor="@color/text_primary_light"
            android:textSize="18sp" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="3dp"

            android:text="Set spending limits for each category"

            android:fontFamily="@font/dosis_bold"
            android:textColor="@color/neutral_500"
            android:textSize="12sp" />


        <!-- CATEGORY 1 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="14dp"
            android:padding="14dp"

            android:gravity="center_vertical"
            android:background="@drawable/bg_add_category">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:text="🍔  Food"

                android:fontFamily="@font/dosis_bold"
                android:textColor="@color/text_primary_light"
                android:textSize="14sp" />

            <TextView
                android:text="150,000 MMK"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:fontFamily="@font/dosis_bold"
                android:textColor="@color/primary_500"
                android:textSize="13sp" />

        </LinearLayout>


        <!-- CATEGORY 2 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"
            android:padding="14dp"

            android:gravity="center_vertical"
            android:background="@drawable/bg_add_category">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:text="🚌  Transport"

                android:fontFamily="@font/dosis_bold"
                android:textColor="@color/text_primary_light"
                android:textSize="14sp" />

            <TextView
                android:text="80,000 MMK"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:fontFamily="@font/dosis_bold"
                android:textColor="@color/primary_500"
                android:textSize="13sp" />

        </LinearLayout>


        <!-- ADD CATEGORY -->

        <Button
            android:id="@+id/btnAddCategory"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="12dp"

            android:text="+ Add Category"

            android:textAllCaps="false"

            android:fontFamily="@font/dosis_bold"
            android:textColor="@color/primary_500"

            android:backgroundTint="@color/primary_50" />


        <!-- CREATE -->

        <Button
            android:id="@+id/btnCreateBudget"

            style="@style/Widget.MoneyMate.Button.Primary"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="25dp"
            android:layout_marginBottom="20dp"

            android:text="Create Budget" />

    </LinearLayout>

</ScrollView>