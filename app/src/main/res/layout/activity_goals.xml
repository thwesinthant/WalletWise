<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@drawable/gradient_header_bg">


    <!-- ===================================================== -->
    <!-- MAIN CONTENT -->
    <!-- ===================================================== -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollGoals"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:fillViewport="true"
        android:clipToPadding="false"

        android:paddingBottom="90dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="30dp">


            <!-- ============================================= -->
            <!-- HEADER -->
            <!-- ============================================= -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="44dp">


                <!-- BACK -->

                <ImageView
                    android:id="@+id/btnBack"

                    android:layout_width="36dp"
                    android:layout_height="36dp"

                    android:background="@drawable/circle_bg_white"

                    android:padding="8dp"

                    android:src="@drawable/baseline_arrow_back_24"

                    android:contentDescription="Back"

                    android:clickable="true"
                    android:focusable="true"

                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />


                <!-- TITLE -->

                <TextView
                    android:id="@+id/tvGoalPageTitle"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Goals"

                    android:fontFamily="@font/dosis_extrabold"
                    android:textColor="@color/primary_900"
                    android:textSize="22sp"

                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />


                <!-- ADD GOAL -->

                <TextView
                    android:id="@+id/btnAddGoal"

                    android:layout_width="40dp"
                    android:layout_height="40dp"

                    android:background="@drawable/bg_add_budget_button"

                    android:gravity="center"

                    android:text="+"

                    android:fontFamily="@font/dosis_bold"
                    android:textColor="@color/neutral_0"
                    android:textSize="24sp"

                    android:clickable="true"
                    android:focusable="true"

                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <!-- ============================================= -->
            <!-- SUBTITLE -->
            <!-- ============================================= -->

            <TextView
                android:id="@+id/tvGoalPageSubtitle"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"

                android:text="Build your future, one step at a time"

                android:fontFamily="@font/molengo_regular"
                android:textColor="@color/background_dark"
                android:textSize="12sp" />


            <!-- ============================================= -->
            <!-- GOAL SUMMARY CARD -->
            <!-- ============================================= -->

            <LinearLayout
                android:id="@+id/goalSummaryCard"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:background="@drawable/bg_actions_card"

                android:padding="18dp"

                android:layout_marginTop="22dp"
                android:layout_marginBottom="20dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="SAVINGS GOALS"

                    android:fontFamily="@font/dosis_semibold"
                    android:textColor="@color/primary_500"
                    android:textSize="12sp" />


                <TextView
                    android:id="@+id/tvGoalSummaryTitle"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:text="Your future is in progress"

                    android:fontFamily="@font/dosis_bold"
                    android:textColor="@color/neutral_900"
                    android:textSize="23sp" />


                <TextView
                    android:id="@+id/tvGoalSummarySubtitle"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:text="Every amount you save brings you closer."

                    android:fontFamily="@font/molengo_regular"
                    android:textColor="@color/neutral_500"
                    android:textSize="12sp" />


                <!-- SUMMARY ROW -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="horizontal"

                    android:layout_marginTop="16dp">


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:orientation="vertical">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="Active Goals"

                            android:fontFamily="@font/dosis_medium"
                            android:textColor="@color/neutral_500"
                            android:textSize="11sp" />


                        <TextView
                            android:id="@+id/tvActiveGoals"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="0"

                            android:fontFamily="@font/dosis_bold"
                            android:textColor="@color/neutral_900"
                            android:textSize="21sp" />

                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:orientation="vertical"


                        android:gravity="end">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="Total Saved"

                            android:fontFamily="@font/dosis_medium"
                            android:textColor="@color/neutral_500"
                            android:textSize="11sp" />


                        <TextView
                            android:id="@+id/tvTotalGoalSaved"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="0 MMK"

                            android:fontFamily="@font/dosis_bold"
                            android:textColor="@color/income_green"
                            android:textSize="21sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>


            <!-- ============================================= -->
            <!-- SECTION TITLE -->
            <!-- ============================================= -->

            <TextView
                android:id="@+id/tvYourGoals"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Your Goals"

                android:fontFamily="@font/dosis_bold"
                android:textColor="@color/neutral_900"
                android:textSize="17sp"

                android:layout_marginBottom="10dp" />


            <!-- ============================================= -->
            <!-- EMPTY STATE -->
            <!-- ============================================= -->

            <LinearLayout
                android:id="@+id/emptyGoalState"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"
                android:gravity="center"

                android:padding="28dp"

                android:visibility="gone">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:text="No goals yet"

                    android:fontFamily="@font/dosis_bold"
                    android:textColor="@color/neutral_900"
                    android:textSize="17sp" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:gravity="center"

                    android:text="Create a goal and start building toward something important."

                    android:fontFamily="@font/molengo_regular"
                    android:textColor="@color/neutral_500"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- ============================================= -->
            <!-- GOAL LIST -->
            <!-- ============================================= -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGoals"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:nestedScrollingEnabled="false"

                android:clipToPadding="false"

                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />


            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>



    <!-- Bottom nav -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="82dp"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="12dp"
        android:translationZ="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <include layout="@layout/layout_bottom_nav" />

    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>