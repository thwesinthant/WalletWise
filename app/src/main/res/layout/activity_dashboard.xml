<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_50">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingBottom="24dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/greetName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hello there"
                        android:fontFamily="@font/dosis_extrabold"
                        android:textColor="@color/neutral_900"
                        android:textSize="17sp" />
                    <!-- greetName should be set from ViewModel with the logged-in user's name -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/dosis_semibold"
                        android:text="Welcome back"
                        android:textColor="@color/neutral_500"
                        android:textSize="12sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/notificationContainer"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivNoti"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bell"
                        android:contentDescription="Notifications" />

                    <TextView
                        android:id="@+id/tvNotificationBadge"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_notification_badge"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="1"
                        android:textColor="@color/neutral_0"
                        android:textSize="9sp"
                        android:fontFamily="@font/dosis_extrabold"
                        android:visibility="gone" />

                </FrameLayout>

                <FrameLayout
                    android:id="@+id/avatarContainer"
                    android:layout_width="42dp"
                    android:layout_height="42dp">

                    <TextView
                        android:id="@+id/tvAvatarInitial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_avatar"
                        android:gravity="center"
                        android:text="U"
                        android:fontFamily="@font/dosis_extrabold"
                        android:textColor="@color/neutral_0"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/ivDashboardAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@drawable/circle_mask"
                        android:clipToOutline="true"
                        android:outlineProvider="background"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>



            <!-- Balance card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_balance_card"
                android:padding="20dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_badge"
                        android:gravity="center"
                        android:text="👛"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wallet Balance"
                            android:fontFamily="@font/dosis_semibold"
                            android:textColor="@color/neutral_0"
                            android:textSize="13sp"
                            android:alpha="0.95" />

                        <TextView
                            android:id="@+id/balanceUpdatedDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Updated 12/03/2025"
                            android:fontFamily="@font/molengo_regular"
                            android:textColor="@color/neutral_0"
                            android:textSize="10.5sp"
                            android:alpha="0.7"
                            android:layout_marginTop="1dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/balanceContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <!-- Normal balance -->
                    <TextView
                        android:id="@+id/balanceAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MMK 0.00"
                        android:fontFamily="@font/dosis_semibold"
                        android:textColor="@color/neutral_0"
                        android:textSize="30sp" />

                    <!-- Empty account message -->
                    <LinearLayout
                        android:id="@+id/emptyBalanceState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:gravity="center"
                            android:text="+"
                            android:textColor="@color/neutral_0"
                            android:textSize="24sp"
                            android:fontFamily="@font/dosis_extrabold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Add your first account"
                                android:fontFamily="@font/dosis_extrabold"
                                android:textColor="@color/neutral_0"
                                android:textSize="18sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Start tracking your money"
                                android:fontFamily="@font/molengo_regular"
                                android:textColor="@color/neutral_0"
                                android:alpha="0.75"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Expense pill -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_white_pill"
                        android:padding="10dp"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_split_icon"
                            android:gravity="center"
                            android:fontFamily="@font/dosis_bold"
                            android:text="↑"
                            android:textColor="@color/expense_red"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:id="@+id/expenseLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Expense"
                                android:fontFamily="@font/molengo_regular"
                                android:textColor="@color/neutral_500"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/expenseAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$0.00"
                                android:fontFamily="@font/dosis_semibold"
                                android:textColor="@color/neutral_900"
                                android:textSize="13sp"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Income pill -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_white_pill"
                        android:padding="10dp"
                        android:layout_marginStart="6dp">

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_split_icon"
                            android:fontFamily="@font/dosis_bold"
                            android:gravity="center"
                            android:text="↓"
                            android:textColor="@color/income_green"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:id="@+id/incomeLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Income"
                                android:fontFamily="@font/molengo_regular"
                                android:textColor="@color/neutral_500"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/incomeAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$0.00"
                                android:fontFamily="@font/dosis_semibold"
                                android:textColor="@color/neutral_900"
                                android:textSize="13sp"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Analytics Preview -->

            <LinearLayout
                android:id="@+id/analyticsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <!-- Section Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Financial Overview"
                        android:fontFamily="@font/dosis_semibold"
                        android:textColor="@color/neutral_900"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/btnAnalytics"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View Analytics"
                        android:fontFamily="@font/dosis_semibold"
                        android:textColor="@color/neutral_0"
                        android:background="@drawable/bg_view_all_pill"
                        android:textSize="12sp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="7dp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <!-- Analytics Card -->
                <LinearLayout
                    android:id="@+id/analyticsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_analytics_card"
                    android:padding="18dp"
                    android:clickable="true"
                    android:focusable="true">

                    <!-- Card Top -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Analytics Icon -->
                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_analytics_icon"
                            android:gravity="center"
                            android:text="📊"
                            android:textSize="18sp"
                            android:includeFontPadding="false" />

                        <!-- Title -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Your spending at a glance"
                                android:fontFamily="@font/dosis_extrabold"
                                android:textColor="@color/neutral_900"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Track income, expenses and spending trends"
                                android:fontFamily="@font/molengo_regular"
                                android:textColor="@color/neutral_500"
                                android:textSize="10.5sp" />

                        </LinearLayout>

                        <!-- Arrow -->
                        <TextView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_analytics_arrow"
                            android:gravity="center"
                            android:text="→"
                            android:textColor="@color/primary_500"
                            android:textSize="16sp"
                            android:fontFamily="@font/dosis_extrabold" />

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="14dp"
                        android:background="@color/neutral_100" />

                    <!-- Mini Statistics -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Income -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Income"
                                android:fontFamily="@font/molengo_regular"
                                android:textColor="@color/neutral_500"
                                android:textSize="9.5sp" />

                            <TextView
                                android:id="@+id/tvAnalyticsIncome"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="MMK 0.00"
                                android:fontFamily="@font/dosis_semibold"
                                android:textColor="@color/income_green"
                                android:textSize="13sp" />

                        </LinearLayout>

                        <!-- Expense -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Expenses"
                                android:fontFamily="@font/molengo_regular"
                                android:textColor="@color/neutral_500"
                                android:textSize="9.5sp" />

                            <TextView
                                android:id="@+id/tvAnalyticsExpense"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="MMK 0.00"
                                android:fontFamily="@font/dosis_semibold"
                                android:textColor="@color/expense_red"
                                android:textSize="13sp" />

                        </LinearLayout>

                        <!-- Net -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Net"
                                android:fontFamily="@font/molengo_regular"
                                android:textColor="@color/neutral_500"
                                android:textSize="9.5sp" />

                            <TextView
                                android:id="@+id/tvAnalyticsNet"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="MMK 0.00"
                                android:fontFamily="@font/dosis_semibold"
                                android:textColor="@color/neutral_900"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>


            </LinearLayout>

            <!-- ACCOUNTS -->
            <LinearLayout
                android:id="@+id/accountsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <!-- Accounts header -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Accounts"
                        android:fontFamily="@font/dosis_semibold"
                        android:textColor="@color/neutral_900"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/btnViewAllAccounts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="See all"
                        android:fontFamily="@font/dosis_semibold"
                        android:textColor="@color/neutral_0"
                        android:background="@drawable/bg_view_all_pill"
                        android:textSize="12sp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="7dp" />

                </LinearLayout>


                <!-- Account summary -->

                <TextView
                    android:id="@+id/tvAccountSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0 accounts · MMK 0.00"
                    android:fontFamily="@font/molengo_regular"
                    android:textColor="@color/neutral_500"
                    android:textSize="11sp"
                    android:layout_marginBottom="10dp" />


                <!-- Horizontal account list -->

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDashboardAccounts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <!-- Empty account add box -->
                <LinearLayout
                    android:id="@+id/emptyDashboardAccounts"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_add_account_box"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:text="+"
                        android:fontFamily="@font/dosis_extrabold"
                        android:textColor="@color/primary_500"
                        android:textSize="30sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Add your first account"
                        android:fontFamily="@font/dosis_extrabold"
                        android:textColor="@color/neutral_900"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Cash, bank or mobile wallet"
                        android:fontFamily="@font/molengo_regular"
                        android:textColor="@color/neutral_500"
                        android:textSize="10sp" />

                </LinearLayout>

            </LinearLayout>



