<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/cardNotification"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"

    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/neutral_0">


    <androidx.constraintlayout.widget.ConstraintLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">


        <!-- ===================================================== -->
        <!-- NOTIFICATION ICON -->
        <!-- ===================================================== -->

        <ImageView
            android:id="@+id/imgIcon"

            android:layout_width="40dp"
            android:layout_height="40dp"

            android:padding="8dp"

            android:src="@android:drawable/ic_popup_reminder"

            android:contentDescription="Notification Icon"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />


        <!-- ===================================================== -->
        <!-- DELETE / CROSS BUTTON -->
        <!-- ===================================================== -->

        <ImageView
            android:id="@+id/btnDelete"

            android:layout_width="32dp"
            android:layout_height="32dp"

            android:padding="7dp"

            android:src="@drawable/ic_close"

            android:contentDescription="Delete notification"

            android:clickable="true"
            android:focusable="true"

            android:background="?attr/selectableItemBackgroundBorderless"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <!-- ===================================================== -->
        <!-- TIME AGO -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/tvTimeAgo"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginEnd="4dp"

            android:fontFamily="@font/molengo_regular"

            android:text="Just now"

            android:textColor="@color/neutral_500"

            android:textSize="12sp"

            app:layout_constraintEnd_toStartOf="@id/btnDelete"
            app:layout_constraintTop_toTopOf="@id/tvTitle"
            app:layout_constraintBottom_toBottomOf="@id/tvTitle" />


        <!-- ===================================================== -->
        <!-- TITLE -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/tvTitle"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"

            android:fontFamily="@font/dosis_bold"

            android:text="Budget alert!"

            android:textColor="@color/primary_900"

            android:textSize="16sp"

            app:layout_constraintStart_toEndOf="@id/imgIcon"
            app:layout_constraintEnd_toStartOf="@id/tvTimeAgo"
            app:layout_constraintTop_toTopOf="parent" />


        <!-- ===================================================== -->
        <!-- MESSAGE -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/tvMessage"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"

            android:fontFamily="@font/molengo_regular"

            android:text="You've used 85% of your Dining budget for this month."

            android:textColor="@color/neutral_500"

            android:textSize="13sp"

            android:lineSpacingExtra="2dp"

            app:layout_constraintStart_toStartOf="@id/tvTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />


        <!-- ===================================================== -->
        <!-- MARK AS READ -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/tvMarkAsRead"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:fontFamily="@font/dosis_bold"

            android:text="Mark as read"

            android:textColor="@color/primary_500"

            android:textSize="13sp"

            app:layout_constraintStart_toStartOf="@id/tvTitle"
            app:layout_constraintTop_toBottomOf="@id/tvMessage" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>