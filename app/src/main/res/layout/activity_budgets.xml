<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_header_bg">

    <!-- Main content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollBudgets"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="90dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBudget"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Budgets"
                        android:fontFamily="@font/dosis_extrabold"
                        android:textColor="@color/neutral_900"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manage your spending plans"
                        android:fontFamily="@font/molengo_regular"
                        android:textColor="@color/background_dark"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <!-- Add button -->
                <TextView
                    android:id="@+id/btnAddBudget"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_add_budget_button"
                    android:gravity="center"
                    android:text="+"
                    android:fontFamily="@font/dosis_bold"
                    android:textColor="@color/neutral_0"
                    android:textSize="25sp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>


            <!-- Current Budget Summary -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_actions_card"
                android:padding="18dp"

                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="This Month"
                    android:fontFamily="@font/dosis_semibold"
                    android:textColor="@color/primary_500"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvTotalBudget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="500,000 MMK"
                    android:fontFamily="@font/dosis_bold"
                    android:textColor="@color/neutral_900"
                    android:textSize="26sp"
                    android:layout_marginTop="3dp" />

                <TextView
                    android:id="@+id/tvBudgetSpent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="310,000 MMK spent"
                    android:fontFamily="@font/dosis_medium"
                    android:textColor="@color/neutral_500"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />

                <!-- Progress -->
                <ProgressBar
                    android:id="@+id/monthBudgetProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="15dp"
                    android:max="100"
                    android:progress="62"
                    android:progressTint="@color/primary_500"
                    android:backgroundTint="@color/primary_100" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="7dp">

                    <TextView
                        android:id="@+id/tvProgressPercent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="62% used"
                        android:fontFamily="@font/dosis_semibold"
                        android:textColor="@color/neutral_700"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvRemaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="190,000 MMK remaining"
                        android:fontFamily="@font/dosis_semibold"
                        android:textColor="@color/income_green"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- Section title -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Budgets"
                android:fontFamily="@font/dosis_bold"
                android:textColor="@color/neutral_900"
                android:textSize="17sp"
                android:layout_marginBottom="10dp" />


            <!-- Budget cards will be added here -->

            <LinearLayout
                android:id="@+id/budgetListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- Bottom Navigation -->

    <LinearLayout
        android:id="@+id/bottomNavBudget"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/neutral_0"
        android:elevation="10dp"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Home -->

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="⌂"
                android:textSize="22sp"
                android:textColor="@color/neutral_500" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:fontFamily="@font/molengo_regular"
                android:textSize="10sp"
                android:textColor="@color/neutral_500" />

        </LinearLayout>


        <!-- Transactions -->

        <LinearLayout
            android:id="@+id/navTransactions"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="▣"
                android:textSize="18sp"
                android:textColor="@color/neutral_500" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transactions"
                android:fontFamily="@font/molengo_regular"
                android:textSize="10sp"
                android:textColor="@color/neutral_500" />

        </LinearLayout>


        <!-- Budgets ACTIVE -->

        <LinearLayout
            android:id="@+id/navBudgets"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="💰"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Budgets"
                android:fontFamily="@font/dosis_semibold"
                android:textSize="10sp"
                android:textColor="@color/primary_500" />

        </LinearLayout>


        <!-- Goals -->

        <LinearLayout
            android:id="@+id/navGoals"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="◎"
                android:textSize="22sp"
                android:textColor="@color/neutral_500" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Goals"
                android:fontFamily="@font/molengo_regular"
                android:textSize="10sp"
                android:textColor="@color/neutral_500" />

        </LinearLayout>


        <!-- Settings -->

        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="⚙"
                android:textSize="18sp"
                android:textColor="@color/neutral_500" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:fontFamily="@font/molengo_regular"
                android:textSize="10sp"
                android:textColor="@color/neutral_500" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>