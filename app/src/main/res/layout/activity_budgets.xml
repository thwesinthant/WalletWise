<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@drawable/gradient_header_bg">


    <!-- ===================================================== -->
    <!-- MAIN CONTENT -->
    <!-- ===================================================== -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollBudgets"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:fillViewport="true"
        android:clipToPadding="false"

        android:paddingBottom="90dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="30dp">


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="44dp">


                <!-- Back button -->

                <ImageView
                    android:id="@+id/btnBack"

                    android:layout_width="36dp"
                    android:layout_height="36dp"

                    android:padding="8dp"

                    android:background="@drawable/circle_bg_white"
                    android:src="@drawable/baseline_arrow_back_24"

                    android:contentDescription="Back"

                    android:clickable="true"
                    android:focusable="true"

                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />


                <!-- Center title -->

                <TextView
                    android:id="@+id/tvBudgetPageTitle"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Budgets"

                    android:fontFamily="@font/dosis_extrabold"
                    android:textColor="@color/primary_900"
                    android:textSize="22sp"

                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />


                <!-- Add budget -->

                <TextView
                    android:id="@+id/btnAddBudget"

                    android:layout_width="40dp"
                    android:layout_height="40dp"

                    android:background="@drawable/bg_add_budget_button"

                    android:gravity="center"

                    android:text="+"

                    android:fontFamily="@font/dosis_bold"
                    android:textColor="@color/neutral_0"
                    android:textSize="24sp"

                    android:clickable="true"
                    android:focusable="true"

                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <!-- ================================================= -->
            <!-- SUBTITLE -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvBudgetPageSubtitle"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_gravity="center_horizontal"

                android:layout_marginTop="4dp"

                android:text="Manage your spending plans"

                android:fontFamily="@font/molengo_regular"
                android:textColor="@color/background_dark"
                android:textSize="12sp" />


            <!-- ================================================= -->
            <!-- CURRENT BUDGET SUMMARY -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/monthBudgetSummary"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:background="@drawable/bg_actions_card"

                android:padding="18dp"

                android:layout_marginTop="22dp"
                android:layout_marginBottom="18dp">


                <!-- Summary label -->

                <TextView
                    android:id="@+id/tvSummaryLabel"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Overall Budget"

                    android:fontFamily="@font/dosis_semibold"
                    android:textColor="@color/primary_500"
                    android:textSize="13sp" />


                <!-- Total budget -->

                <TextView
                    android:id="@+id/tvTotalBudget"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="500,000 MMK"

                    android:fontFamily="@font/dosis_bold"
                    android:textColor="@color/neutral_900"
                    android:textSize="26sp"

                    android:layout_marginTop="3dp" />


                <!-- Spent -->

                <TextView
                    android:id="@+id/tvBudgetSpent"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="310,000 MMK spent"

                    android:fontFamily="@font/dosis_medium"
                    android:textColor="@color/neutral_500"
                    android:textSize="11sp"

                    android:layout_marginTop="2dp" />


                <!-- Progress -->

                <ProgressBar
                    android:id="@+id/monthBudgetProgress"

                    style="?android:attr/progressBarStyleHorizontal"

                    android:layout_width="match_parent"
                    android:layout_height="8dp"

                    android:layout_marginTop="15dp"

                    android:max="100"
                    android:progress="62"

                    android:progressTint="@color/primary_500"
                    android:backgroundTint="@color/primary_100" />


                <!-- Progress information -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="horizontal"

                    android:layout_marginTop="7dp">


                    <TextView
                        android:id="@+id/tvProgressPercent"

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:text="62% used"

                        android:fontFamily="@font/dosis_semibold"
                        android:textColor="@color/neutral_700"
                        android:textSize="11sp" />


                    <TextView
                        android:id="@+id/tvMonthRemaining"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="190,000 MMK remaining"

                        android:fontFamily="@font/dosis_semibold"
                        android:textColor="@color/income_green"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- BUDGET LIST TITLE -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvYourBudgets"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Your Budgets"

                android:fontFamily="@font/dosis_bold"
                android:textColor="@color/neutral_900"
                android:textSize="17sp"

                android:layout_marginBottom="10dp" />


            <!-- ================================================= -->
            <!-- BUDGET LIST -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/budgetListContainer"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical" />


            <!-- Bottom spacing -->

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>



    <!-- Bottom nav -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="82dp"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="12dp"
        android:translationZ="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <include layout="@layout/layout_bottom_nav" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>

