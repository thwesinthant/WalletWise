<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_header_bg">

    <!-- ============================================= -->
    <!-- FIXED TOP NAVIGATION -->
    <!-- ============================================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topNav"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- BACK BUTTON -->

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="20dp"
            android:padding="8dp"
            android:background="@drawable/circle_bg_white"
            android:src="@drawable/baseline_arrow_back_24"
            android:contentDescription="Back"
            android:clickable="true"
            android:focusable="true"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- TITLE -->

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notifications"
            android:fontFamily="@font/dosis_extrabold"
            android:textSize="20sp"
            android:textColor="@color/primary_900"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            app:layout_constraintBottom_toBottomOf="@id/btnBack" />

        <!-- SETTINGS BUTTON -->

        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="20dp"
            android:padding="7dp"
            android:src="@drawable/ic_settings"
            android:contentDescription="Notification settings"
            android:clickable="true"
            android:focusable="true"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            app:layout_constraintBottom_toBottomOf="@id/btnBack" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ============================================= -->
    <!-- NOTIFICATION LIST -->
    <!-- ============================================= -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNotifications"
        android:layout_width="0dp"
        android:layout_height="0dp"

        android:layout_marginTop="8dp"

        android:paddingTop="4dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false"

        app:layout_constraintTop_toBottomOf="@id/topNav"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ============================================= -->
    <!-- EMPTY STATE -->
    <!-- ============================================= -->

    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingBottom="40dp"
        android:visibility="gone"

        app:layout_constraintTop_toBottomOf="@id/topNav"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- EMPTY IMAGE -->

        <ImageView
            android:id="@+id/noti"
            android:layout_width="220dp"
            android:layout_height="210dp"
            android:src="@drawable/noti"
            android:contentDescription="Empty Notification" />

        <!-- EMPTY TITLE -->

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="You're all caught up"
            android:fontFamily="@font/dosis_bold"
            android:textColor="@color/text_primary_light"
            android:textSize="20sp" />

        <!-- EMPTY SUBTITLE -->

        <TextView
            android:id="@+id/tvEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Come back later for budget alerts, bill reminders, and spending insights"
            android:fontFamily="@font/molengo_regular"
            android:textColor="@color/text_secondary_light"
            android:textSize="15sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>