<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog_card">


    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginBottom="16dp"

        android:gravity="center_vertical"
        android:orientation="horizontal">


        <!-- Piggy Icon -->

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"

            android:src="@drawable/piggy"

            android:contentDescription="Add money" />


        <!-- Title -->

        <TextView
            android:id="@+id/tvAddMoneyTitle"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"
            android:layout_marginStart="10dp"

            android:fontFamily="@font/dosis_bold"

            android:text="Add Money"

            android:textColor="@color/neutral_900"
            android:textSize="21sp" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- AMOUNT -->
    <!-- ===================================================== -->

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilAddAmount"

        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:hint="Amount to add"

        app:boxCornerRadiusTopStart="10dp"
        app:boxCornerRadiusTopEnd="10dp"
        app:boxCornerRadiusBottomStart="10dp"
        app:boxCornerRadiusBottomEnd="10dp"

        app:boxStrokeColor="@color/primary_500"
        app:hintTextColor="@color/primary_500"

        app:suffixText="MMK">


        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAddAmount"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:inputType="numberDecimal"

            android:fontFamily="@font/dosis_medium"

            android:textColor="@color/neutral_900"
            android:textSize="15sp" />

    </com.google.android.material.textfield.TextInputLayout>


    <!-- ===================================================== -->
    <!-- BUTTONS -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"

        android:layout_marginTop="20dp"

        android:gravity="end|center_vertical"
        android:orientation="horizontal">


        <!-- Cancel -->

        <TextView
            android:id="@+id/btnAddMoneyCancel"

            android:layout_width="wrap_content"
            android:layout_height="44dp"

            android:background="@drawable/button_border"

            android:gravity="center"

            android:minWidth="82dp"

            android:paddingStart="16dp"
            android:paddingEnd="16dp"

            android:fontFamily="@font/dosis_semibold"

            android:text="Cancel"

            android:textColor="@color/neutral_700"
            android:textSize="14sp"

            android:clickable="true"
            android:focusable="true" />


        <!-- Add Money -->

        <TextView
            android:id="@+id/btnAddMoneyConfirm"

            android:layout_width="wrap_content"
            android:layout_height="44dp"

            android:layout_marginStart="8dp"

            android:background="@drawable/bg_add_budget_button"

            android:gravity="center"

            android:minWidth="82dp"

            android:paddingStart="18dp"
            android:paddingEnd="18dp"

            android:fontFamily="@font/dosis_bold"

            android:text="Add"

            android:textColor="@color/neutral_0"
            android:textSize="14sp"

            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>


</LinearLayout>

