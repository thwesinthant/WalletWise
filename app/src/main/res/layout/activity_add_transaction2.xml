<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_header_bg"
    tools:context=".ui.expense.AddTransactionActivity">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="8dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/circle_bg_white"
        android:src="@drawable/baseline_arrow_back_24"
        android:contentDescription="Back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Expense"
        android:fontFamily="@font/dosis_extrabold"
        android:textSize="20sp"
        android:textColor="@color/primary_900"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/typeSelector"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="28dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/selector_bg"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvExpense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Expenses"
            android:fontFamily="@font/dosis_semibold"
            android:textSize="16sp"
            android:textColor="@color/neutral_0"
            android:background="@drawable/selector_selected_bg"
            android:paddingVertical="12dp" />

        <TextView
            android:id="@+id/tvIncome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Income"
            android:fontFamily="@font/dosis_semibold"
            android:textSize="16sp"
            android:textColor="@color/neutral_500"
            android:paddingVertical="12dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvAmountLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Amount"
        android:textSize="14sp"
        android:textColor="@color/neutral_500"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toBottomOf="@id/typeSelector"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$0.00"
        android:textSize="34sp"
        android:textColor="@color/background_dark"
        android:fontFamily="@font/dosis_extrabold"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvAmountLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/categoryRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/card_bg"
        android:padding="14dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toBottomOf="@id/tvAmount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_category"
            android:contentDescription="Category" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Category"
            android:textSize="16sp"
            android:textColor="@color/primary_500"
            android:layout_marginStart="12dp" />

        <ImageView
            android:layout_width="25dp"
            android:layout_height="20dp"
            android:contentDescription="Dropdown"
            android:src="@drawable/ic_arrow_down" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAdd"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="Add Expense"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/neutral_0"
        android:fontFamily="@font/dosis_extrabold"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        app:backgroundTint="@color/primary_500"
        app:cornerRadius="28dp"
        app:layout_constraintTop_toBottomOf="@id/categoryRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/keypadArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@color/neutral_0"
        android:layout_marginTop="38dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnAdd"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="4">

            <TextView
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:gravity="center"
                android:text="1"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/primary_500"
                android:background="@drawable/key_bg" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:gravity="center"
                android:text="2"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/primary_500"
                android:background="@drawable/key_bg" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:gravity="center"
                android:text="3"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/primary_500"
                android:background="@drawable/key_bg" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:gravity="center"
                android:text="4"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/primary_500"
                android:background="@drawable/key_bg" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:gravity="center"
                android:text="5"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/primary_500"
                android:background="@drawable/key_bg" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:gravity="center"
                android:text="6"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/primary_500"
                android:background="@drawable/key_bg" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:gravity="center"
                android:text="7"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/primary_500"
                android:background="@drawable/key_bg" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:gravity="center"
                android:text="8"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/primary_500"
                android:background="@drawable/key_bg" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:gravity="center"
                android:text="9"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/primary_500"
                android:background="@drawable/key_bg" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:gravity="center"
                android:text="."
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/primary_500"
                android:background="@drawable/key_bg" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:gravity="center"
                android:text="0"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/primary_500"
                android:background="@drawable/key_bg" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:gravity="center"
                android:text="DEL"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/expense_red"
                android:background="@drawable/key_bg" />
        </GridLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>