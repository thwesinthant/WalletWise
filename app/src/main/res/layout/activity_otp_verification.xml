<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@drawable/bg_gradient"

    android:fillViewport="true"
    android:clipToPadding="false"

    tools:context=".auth.OtpVerificationActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical">


        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="285dp">


            <!-- ================================================= -->
            <!-- BACK BUTTON -->
            <!-- ================================================= -->

            <ImageButton
                android:id="@+id/btnBack"

                android:layout_width="48dp"
                android:layout_height="48dp"

                android:layout_gravity="top|start"

                android:layout_marginStart="12dp"
                android:layout_marginTop="42dp"

                android:background="?attr/selectableItemBackgroundBorderless"

                android:contentDescription="Back"

                android:padding="12dp"

                android:src="@drawable/baseline_arrow_back_24"

                app:tint="@color/neutral_0" />


            <!-- ================================================= -->
            <!-- BRAND -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_gravity="center"

                android:gravity="center"

                android:orientation="vertical">


                <ImageView
                    android:id="@+id/imgLogo"

                    android:layout_width="95dp"
                    android:layout_height="95dp"

                    android:adjustViewBounds="true"

                    android:contentDescription="WalletWise Logo"

                    android:scaleType="fitCenter"

                    android:src="@drawable/walletwise_logo" />


                <TextView
                    android:id="@+id/tvWalletWise"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="5dp"

                    android:fontFamily="@font/dosis_extrabold"

                    android:text="WalletWise"

                    android:textColor="@color/text_primary_light"

                    android:textSize="28sp"

                    android:textStyle="bold"

                    android:letterSpacing="0.03" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="2dp"

                    android:fontFamily="@font/molengo_regular"

                    android:text="Spend smarter. Live better."

                    android:textColor="@color/text_primary_light"

                    android:textSize="12sp"

                    android:alpha="0.75" />

            </LinearLayout>

        </FrameLayout>


        <!-- ================================================= -->
        <!-- OTP CARD -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/formCard"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="-26dp"

            android:background="@drawable/bg_login_card"

            android:elevation="7dp"

            android:orientation="vertical"

            android:paddingStart="24dp"
            android:paddingTop="27dp"
            android:paddingEnd="24dp"
            android:paddingBottom="26dp">


            <!-- TITLE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:fontFamily="@font/dosis_extrabold"

                android:text="Enter OTP Code"

                android:textAlignment="center"

                android:textColor="@color/primary_500"

                android:textSize="22sp"

                android:textStyle="bold" />


            <!-- SUBTITLE -->

            <TextView
                android:id="@+id/tvSubtitle"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="8dp"

                android:fontFamily="@font/molengo_regular"

                android:text="We've sent a 4-digit code to your email. Enter it below to continue."

                android:textAlignment="center"

                android:textColor="@color/text_secondary_light"

                android:textSize="14sp" />


            <!-- OTP BOXES -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_gravity="center"

                android:layout_marginTop="30dp"

                android:orientation="horizontal">


                <EditText
                    android:id="@+id/etOtp1"

                    android:layout_width="52dp"
                    android:layout_height="56dp"

                    android:layout_marginHorizontal="5dp"

                    android:background="@drawable/bg_input_box"

                    android:fontFamily="@font/dosis_extrabold"

                    android:gravity="center"

                    android:inputType="number"

                    android:maxLength="1"

                    android:textColor="@color/text_primary_light"

                    android:textSize="20sp" />


                <EditText
                    android:id="@+id/etOtp2"

                    android:layout_width="52dp"
                    android:layout_height="56dp"

                    android:layout_marginHorizontal="5dp"

                    android:background="@drawable/bg_input_box"

                    android:fontFamily="@font/dosis_extrabold"

                    android:gravity="center"

                    android:inputType="number"

                    android:maxLength="1"

                    android:textColor="@color/text_primary_light"

                    android:textSize="20sp" />


                <EditText
                    android:id="@+id/etOtp3"

                    android:layout_width="52dp"
                    android:layout_height="56dp"

                    android:layout_marginHorizontal="5dp"

                    android:background="@drawable/bg_input_box"

                    android:fontFamily="@font/dosis_extrabold"

                    android:gravity="center"

                    android:inputType="number"

                    android:maxLength="1"

                    android:textColor="@color/text_primary_light"

                    android:textSize="20sp" />


                <EditText
                    android:id="@+id/etOtp4"

                    android:layout_width="52dp"
                    android:layout_height="56dp"

                    android:layout_marginHorizontal="5dp"

                    android:background="@drawable/bg_input_box"

                    android:fontFamily="@font/dosis_extrabold"

                    android:gravity="center"

                    android:inputType="number"

                    android:maxLength="1"

                    android:textColor="@color/text_primary_light"

                    android:textSize="20sp" />

            </LinearLayout>


            <!-- VERIFY BUTTON -->

            <Button
                android:id="@+id/btnVerifyCode"

                android:layout_width="match_parent"
                android:layout_height="54dp"

                android:layout_marginTop="26dp"

                android:background="@drawable/bg_gradient_pill_button"

                android:backgroundTint="@null"

                android:fontFamily="@font/dosis_extrabold"

                android:stateListAnimator="@null"

                android:text="Verify Code"

                android:textAllCaps="false"

                android:textColor="@color/neutral_0"

                android:textSize="18sp"

                android:textStyle="bold" />


            <!-- RESEND -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="17dp"

                android:gravity="center"

                android:orientation="horizontal">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:fontFamily="@font/dosis_semibold"

                    android:text="Didn't receive the code? "

                    android:textColor="@color/neutral_500"

                    android:textSize="13sp" />


                <TextView
                    android:id="@+id/tvResendCode"

                    android:layout_width="wrap_content"
                    android:layout_height="48dp"

                    android:gravity="center"

                    android:fontFamily="@font/dosis_bold"

                    android:text="Resend"

                    android:textColor="@color/primary_500"

                    android:textSize="13sp"

                    android:textStyle="bold" />

            </LinearLayout>


        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

