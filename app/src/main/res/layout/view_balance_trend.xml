<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_white"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/dosis_bold"
        android:text="@string/balance_trend"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/dosis_regular"
        android:text="@string/balance_trend_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dosis_regular"
                android:text="@string/today_label"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvCurrentValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/dosis_bold"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                tools:text="MMK 74,164.71" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dosis_regular"
                android:text="@string/vs_past_period"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvChangeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/dosis_bold"
                android:textColor="@color/expense_red"
                android:textSize="18sp"
                tools:text="-98%" />
        </LinearLayout>
    </LinearLayout>

    <!--
      Wrapping the chart in a HorizontalScrollView lets LineAreaChartView
      measure itself wider than the card (one "slot" per month) and scroll
      sideways, instead of squeezing all 12 months into the screen width.
      scrollX is set to the far right in code so "Today" is visible first.
    -->
    <HorizontalScrollView
        android:id="@+id/trendScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <com.example.walletwise.dashboard.LineAreaChartView
            android:id="@+id/lineChart"
            android:layout_width="wrap_content"
            android:layout_height="140dp" />
    </HorizontalScrollView>
</LinearLayout>
