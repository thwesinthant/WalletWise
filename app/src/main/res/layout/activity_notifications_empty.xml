<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_header_bg">

    <!-- ============================================= -->
    <!-- FIXED TOP NAVIGATION -->
    <!-- ============================================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topNav"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- BACK BUTTON -->

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="20dp"
            android:padding="8dp"
            android:background="@drawable/circle_bg_white"
            android:src="@drawable/baseline_arrow_back_24"
            android:contentDescription="Back"
            android:clickable="true"
            android:focusable="true"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- TITLE -->

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notifications"
            android:fontFamily="@font/dosis_extrabold"
            android:textSize="20sp"
            android:textColor="@color/primary_900"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            app:layout_constraintBottom_toBottomOf="@id/btnBack" />

        <!-- SETTINGS BUTTON -->

        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="20dp"
            android:padding="9dp"
            android:src="@drawable/ic_settings"
            android:contentDescription="Notification settings"
            android:clickable="true"
            android:focusable="true"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            app:layout_constraintBottom_toBottomOf="@id/btnBack" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ============================================= -->
    <!-- EMPTY STATE -->
    <!-- ============================================= -->

    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingBottom="40dp"

        app:layout_constraintTop_toBottomOf="@id/topNav"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- EMPTY IMAGE -->

        <ImageView
            android:id="@+id/noti"
            android:layout_width="250dp"
            android:layout_height="240dp"
            android:src="@drawable/noti"
            android:contentDescription="Empty Notification" />

        <!-- EMPTY TITLE -->

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="You're all caught up"
            android:textColor="@color/text_primary_light"
            android:textSize="20sp"
            android:fontFamily="@font/dosis_bold" />

        <!-- EMPTY SUBTITLE -->

        <TextView
            android:id="@+id/tvEmptySubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Come back later for budget alerts, bill reminders, and spending insights"
            android:textColor="@color/text_secondary_light"
            android:textSize="15sp"
            android:fontFamily="@font/molengo_regular" />

    </LinearLayout>


    <!-- ============================================= -->
    <!-- TOP SHADOW OF BOTTOM NAV -->
    <!-- ============================================= -->

    <View
        android:id="@+id/navShadow"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:background="@drawable/shadow_top"

        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ============================================= -->
    <!-- FIXED BOTTOM NAVIGATION -->
    <!-- ============================================= -->

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="78dp"
        android:orientation="horizontal"
        android:background="@color/neutral_0"
        android:gravity="center_vertical"
        android:paddingBottom="14dp"
        android:elevation="4dp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- HOME -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="35dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_nav_active"
                android:gravity="center"
                android:text="🏠"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:fontFamily="@font/dosis_bold"
                android:textColor="@color/neutral_500"
                android:textSize="12sp"
                android:layout_marginTop="5dp" />

        </LinearLayout>


        <!-- TRANSACTION -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="📋"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transaction"
                android:fontFamily="@font/dosis_bold"
                android:textColor="@color/neutral_500"
                android:textSize="12sp"
                android:layout_marginTop="5dp" />

        </LinearLayout>


        <!-- BUDGETS -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="💰"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Budgets"
                android:fontFamily="@font/dosis_bold"
                android:textColor="@color/neutral_500"
                android:textSize="12sp"
                android:layout_marginTop="5dp" />

        </LinearLayout>


        <!-- GOALS -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="🎯"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Goals"
                android:fontFamily="@font/dosis_bold"
                android:textColor="@color/neutral_500"
                android:textSize="12sp"
                android:layout_marginTop="5dp" />

        </LinearLayout>


        <!-- SETTINGS -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="⚙️"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:fontFamily="@font/dosis_bold"
                android:textColor="@color/neutral_500"
                android:textSize="12sp"
                android:layout_marginTop="5dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>