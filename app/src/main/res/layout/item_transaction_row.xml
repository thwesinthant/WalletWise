<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_expense_row"
    android:padding="10dp"
    android:layout_marginBottom="10dp">

    <!-- CATEGORY ICON -->

    <ImageView
        android:id="@+id/ivCategoryIcon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_recent_transaction_icon"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:contentDescription="Category icon" />


    <!-- TITLE / SUBTITLE -->

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tvTxnTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Groceries"
            android:fontFamily="@font/dosis_semibold"
            android:textColor="@color/neutral_900"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvTxnSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="via Cash"
            android:fontFamily="@font/molengo_regular"
            android:textColor="@color/neutral_500"
            android:textSize="11sp"
            android:layout_marginTop="1dp" />

    </LinearLayout>


    <!-- AMOUNT -->

    <TextView
        android:id="@+id/tvTxnAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-$50.00"
        android:textSize="14sp" />


    <!-- MORE ACTIONS -->

    <TextView
        android:id="@+id/btnTransactionMore"
        android:layout_width="36dp"
        android:layout_height="42dp"
        android:layout_marginStart="6dp"
        android:gravity="center"
        android:text="⋮"
        android:textSize="24sp"
        android:textColor="@color/neutral_500"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Transaction actions" />

</LinearLayout>