<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@drawable/bg_gradient"

    android:fillViewport="true"
    android:clipToPadding="false"

    tools:context=".auth.LoginActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical">


        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="285dp">


            <!-- ================================================= -->
            <!-- BRAND -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_gravity="center"

                android:gravity="center"

                android:orientation="vertical">


                <!-- Logo -->

                <ImageView
                    android:id="@+id/imgLogo"

                    android:layout_width="95dp"
                    android:layout_height="95dp"

                    android:adjustViewBounds="true"

                    android:contentDescription="WalletWise Logo"

                    android:scaleType="fitCenter"

                    android:src="@drawable/walletwise_logo" />


                <!-- Brand Name -->

                <TextView
                    android:id="@+id/tvWalletWise"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="5dp"

                    android:fontFamily="@font/dosis_extrabold"

                    android:text="WalletWise"

                    android:textColor="@color/text_primary_light"

                    android:textSize="28sp"

                    android:textStyle="bold"

                    android:letterSpacing="0.03" />


                <!-- Tagline -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="2dp"

                    android:fontFamily="@font/molengo_regular"

                    android:text="Spend smarter. Live better."

                    android:textColor="@color/text_primary_light"

                    android:textSize="12sp"

                    android:alpha="0.75" />

            </LinearLayout>

        </FrameLayout>


        <!-- ================================================= -->
        <!-- LOGIN CARD -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/formCard"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="-26dp"

            android:background="@drawable/bg_login_card"

            android:elevation="7dp"

            android:orientation="vertical"

            android:paddingStart="24dp"
            android:paddingTop="27dp"
            android:paddingEnd="24dp"
            android:paddingBottom="26dp">


            <!-- ================================================= -->
            <!-- TITLE -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:fontFamily="@font/dosis_extrabold"

                android:text="Login Account"

                android:textAlignment="center"

                android:textColor="@color/primary_500"

                android:textSize="22sp"

                android:textStyle="bold" />



            <!-- ================================================= -->
            <!-- EMAIL -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="25dp"

                android:fontFamily="@font/dosis_semibold"

                android:text="Email"

                android:textColor="@color/text_primary_light"

                android:textSize="14sp" />


            <EditText
                android:id="@+id/etEmail"

                android:layout_width="match_parent"
                android:layout_height="52dp"

                android:layout_marginTop="6dp"

                android:background="@drawable/bg_input_box"

                android:fontFamily="@font/molengo_regular"

                android:hint="Enter your email"

                android:inputType="textEmailAddress"

                android:paddingStart="16dp"
                android:paddingEnd="16dp"

                android:singleLine="true"

                android:textColor="@color/text_primary_light"

                android:textColorHint="@color/neutral_500"

                android:textSize="14sp" />


            <!-- ================================================= -->
            <!-- PASSWORD -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="16dp"

                android:fontFamily="@font/dosis_semibold"

                android:text="Password"

                android:textColor="@color/text_primary_light"

                android:textSize="14sp" />


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"

                android:layout_marginTop="6dp"

                android:background="@drawable/bg_input_box">


                <EditText
                    android:id="@+id/etPassword"

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:background="@null"

                    android:fontFamily="@font/molengo_regular"

                    android:hint="Enter your password"

                    android:inputType="textPassword"

                    android:paddingStart="16dp"
                    android:paddingEnd="52dp"

                    android:singleLine="true"

                    android:textColor="@color/text_primary_light"

                    android:textColorHint="@color/neutral_500"

                    android:textSize="14sp" />


                <ImageButton
                    android:id="@+id/btnTogglePassword"

                    android:layout_width="48dp"
                    android:layout_height="48dp"

                    android:layout_gravity="center_vertical|end"

                    android:background="?attr/selectableItemBackgroundBorderless"

                    android:contentDescription="Show or hide password"

                    android:padding="12dp"

                    android:src="@android:drawable/ic_menu_view"

                    app:tint="@color/neutral_500" />

            </FrameLayout>


            <!-- ================================================= -->
            <!-- REMEMBER + FORGOT -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="5dp"

                android:gravity="center_vertical"

                android:orientation="horizontal">


                <CheckBox
                    android:id="@+id/cbRememberMe"

                    android:layout_width="wrap_content"
                    android:layout_height="48dp"

                    android:button="@drawable/checkbox_selector"

                    android:fontFamily="@font/dosis_semibold"

                    android:text="Remember me"

                    android:textColor="@color/text_secondary_light"

                    android:textSize="13sp"

                    app:buttonTint="@null" />


                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"

                    android:layout_weight="1" />


                <TextView
                    android:id="@+id/tvForgotPassword"

                    android:layout_width="wrap_content"
                    android:layout_height="48dp"

                    android:gravity="center"

                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"

                    android:fontFamily="@font/dosis_semibold"

                    android:text="Forgot password?"

                    android:textColor="@color/primary_500"

                    android:textSize="13sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- LOGIN BUTTON -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/btnLogIn"

                android:layout_width="match_parent"
                android:layout_height="54dp"

                android:layout_marginTop="8dp"

                android:background="@drawable/bg_gradient_pill_button"

                android:backgroundTint="@null"

                android:fontFamily="@font/dosis_extrabold"

                android:stateListAnimator="@null"

                android:text="Log In"

                android:textAllCaps="false"

                android:textColor="@color/neutral_0"

                android:textSize="18sp"

                android:textStyle="bold" />


            <!-- ================================================= -->
            <!-- SIGN UP -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="17dp"

                android:gravity="center"

                android:orientation="horizontal">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:fontFamily="@font/dosis_semibold"

                    android:text="Don't have an account? "

                    android:textColor="@color/neutral_500"

                    android:textSize="13sp" />


                <TextView
                    android:id="@+id/tvGoToSignUp"

                    android:layout_width="wrap_content"
                    android:layout_height="48dp"

                    android:gravity="center"

                    android:fontFamily="@font/dosis_bold"

                    android:text="Sign Up"

                    android:textColor="@color/primary_500"

                    android:textSize="13sp"

                    android:textStyle="bold" />

            </LinearLayout>


        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>