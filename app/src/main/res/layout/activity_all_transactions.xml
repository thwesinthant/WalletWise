<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/transactionRoot"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_phone_gradient">


    <!-- ============================== -->
    <!-- TOP BAR -->
    <!-- ============================== -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Reusable Back Button -->

        <include
            android:id="@+id/btnBack"
            layout="@layout/view_back_button"
            android:layout_width="36dp"
            android:layout_height="36dp" />


        <!-- Title -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvPageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Transactions"
                android:fontFamily="@font/dosis_extrabold"
                android:textColor="@color/neutral_900"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/tvPageSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Your complete transaction history"
                android:fontFamily="@font/molengo_regular"
                android:textColor="@color/neutral_500"
                android:textSize="10sp" />

        </LinearLayout>


        <!-- Filter / Sort -->

        <TextView
            android:id="@+id/btnFilterSort"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/circle_bg_white"
            android:gravity="center"
            android:text="⇅"
            android:fontFamily="@font/dosis_bold"
            android:textColor="@color/primary_500"
            android:textSize="19sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Filter and sort" />

    </LinearLayout>


    <!-- ============================== -->
    <!-- FILTER CHIPS -->
    <!-- ============================== -->

    <HorizontalScrollView
        android:id="@+id/filterScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="14dp">

            <!-- All -->
            <TextView
                android:id="@+id/filterAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_filter_selected"
                android:paddingHorizontal="17dp"
                android:paddingVertical="8dp"
                android:text="All"
                android:fontFamily="@font/dosis_semibold"
                android:textColor="@color/neutral_0"
                android:textSize="11sp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Income -->
            <TextView
                android:id="@+id/filterIncome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_filter_unselected"
                android:paddingHorizontal="17dp"
                android:paddingVertical="8dp"
                android:text="Income"
                android:fontFamily="@font/dosis_semibold"
                android:textColor="@color/neutral_500"
                android:textSize="11sp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Expense -->
            <TextView
                android:id="@+id/filterExpense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_filter_unselected"
                android:paddingHorizontal="17dp"
                android:paddingVertical="8dp"
                android:text="Expense"
                android:fontFamily="@font/dosis_semibold"
                android:textColor="@color/neutral_500"
                android:textSize="11sp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </HorizontalScrollView>


    <!-- ============================== -->
    <!-- ALL TRANSACTIONS -->
    <!-- ============================== -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAllTransactions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="95dp"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/filterScroll"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_transaction_row" />


    <!-- ============================== -->
    <!-- EMPTY STATE -->
    <!-- ============================== -->

    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/filterScroll"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_action_circle"
            android:gravity="center"
            android:text="+"
            android:fontFamily="@font/dosis_extrabold"
            android:textColor="@color/primary_500"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No transactions yet"
            android:fontFamily="@font/dosis_semibold"
            android:textColor="@color/neutral_900"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvEmptyMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Your transactions will appear here."
            android:fontFamily="@font/molengo_regular"
            android:textColor="@color/neutral_500"
            android:textSize="11sp" />

    </LinearLayout>


    <!-- ============================== -->
    <!-- FLOATING ADD BUTTON -->
    <!-- ============================== -->

    <TextView
        android:id="@+id/fabAddTransaction"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_fab_add"
        android:elevation="8dp"
        android:gravity="center"
        android:text="+"
        android:fontFamily="@font/dosis_extrabold"
        android:textColor="@color/neutral_0"
        android:textSize="26sp"
        android:includeFontPadding="false"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Add transaction"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
