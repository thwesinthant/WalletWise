<?xml version="1.0" encoding="utf-8"?>
<!-- Reused for both the Income and Expense chips inside the balance overview card.
     Background, icon and tint are configured at runtime (see MainActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_chip_income"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/chipIconCircle"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_circle_white">

            <ImageView
                android:id="@+id/ivChipIcon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_upward" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvChipLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/dosis_regular"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="Income" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvChipAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/dosis_bold"
        android:textColor="@color/text_primary"
        android:maxLines="1"
        android:ellipsize="end"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="11sp"
        app:autoSizeMaxTextSize="17sp"
        app:autoSizeStepGranularity="1sp"
        tools:text="MMK 858,000.00" />
</LinearLayout>