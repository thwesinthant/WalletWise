<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- When Spinner is pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">

            <solid android:color="@color/primary_100" />

            <stroke
                android:width="1dp"
                android:color="@color/primary_500" />

            <corners android:radius="12dp" />

            <padding
                android:left="16dp"
                android:top="12dp"
                android:right="16dp"
                android:bottom="12dp" />

        </shape>
    </item>

    <!-- Normal state -->
    <item>
        <shape android:shape="rectangle">

            <solid android:color="@color/neutral_0" />

            <stroke
                android:width="1dp"
                android:color="@color/primary_200" />

            <corners android:radius="12dp" />

            <padding
                android:left="16dp"
                android:top="12dp"
                android:right="16dp"
                android:bottom="12dp" />

        </shape>
    </item>

</selector>