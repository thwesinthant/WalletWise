<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

<!--    for dashboard -->
    <style name="Theme.DashboardApp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorPrimaryDark">@color/blue_primary_dark</item>
        <item name="colorAccent">@color/blue_primary</item>
        <item name="fontFamily">@font/dosis_regular</item>
    </style>
    <style name="ThemeOverlay.App.DatePicker" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="materialCalendarHeaderToggleButton">@style/Widget.App.DatePicker.HeaderToggleButton</item>
    </style>
    <style name="Widget.App.DatePicker.HeaderToggleButton" parent="Widget.MaterialComponents.MaterialCalendar.HeaderToggleButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
    </style>

    <!-- for add budget theme    -->
    <style name="Theme.WalletWise.Starting" parent="Theme.SplashScreen">

        <item name="windowSplashScreenBackground">@color/splash_background</item>

        <item name="windowSplashScreenAnimatedIcon">@drawable/walletwise_logo_cleaned</item>

        <item name="windowSplashScreenIconBackgroundColor">@color/splash_background</item>

        <item name="postSplashScreenTheme">@style/Theme.ExpenceAndBudgetTracker</item>

    </style>

    <style name="Theme.WalletWise.DatePicker"
        parent="Theme.MaterialComponents.Light.Dialog.Alert">

        <!-- Main accent -->
        <item name="colorAccent">@color/primary_500</item>
        <item name="colorControlActivated">@color/primary_500</item>
        <item name="colorControlHighlight">@color/primary_100</item>
        <item name="android:colorAccent">@color/primary_500</item>

        <!-- Calendar/dialog text -->
        <item name="android:textColorPrimary">@color/text_primary_light</item>
        <item name="android:textColorSecondary">@color/text_secondary_light</item>

        <!-- Action buttons -->
        <item name="buttonBarPositiveButtonStyle">@style/WalletWiseDatePickerButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/WalletWiseDatePickerButton</item>

    </style>

    <style name="WalletWiseDatePickerButton"
        parent="Widget.MaterialComponents.Button.TextButton">

        <item name="android:textColor">@color/primary_500</item>
        <item name="android:textAllCaps">false</item>

    </style>

<!--    for category -->
    <style name="DeleteCategoryDialogTheme" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_rounded</item>
        <item name="android:textColorPrimary">@color/neutral_0</item>
        <item name="android:textColorSecondary">@color/neutral_500</item>
        <item name="buttonBarPositiveButtonStyle">@style/DeleteCategoryDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/DeleteCategoryDialogButton</item>
    </style>

    <style name="DeleteCategoryDialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/primary_300</item>
    </style>

    <style name="Theme.ExpenceAndBudgetTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_500</item>
        <item name="colorOnPrimary">@color/neutral_0</item>
        <item name="colorPrimaryContainer">@color/primary_100</item>
        <item name="colorOnPrimaryContainer">@color/primary_900</item>

        <item name="colorSecondary">@color/accent_500</item>
        <item name="colorOnSecondary">@color/neutral_900</item>
        <item name="colorSecondaryContainer">@color/accent_100</item>
        <item name="colorOnSecondaryContainer">@color/accent_700</item>

        <item name="colorError">@color/expense_red</item>
        <item name="colorOnError">@color/neutral_0</item>

        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_light</item>

        <item name="android:statusBarColor">@color/primary_700</item>
        <item name="android:windowLightStatusBar">false</item>


    </style>

    <style name="Widget.MoneyMate.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_500</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="KeypadKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/text_primary_light</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.MoneyMate.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/primary_500</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.MoneyMate.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/primary_500</item>
        <item name="hintTextColor">@color/primary_500</item>
    </style>


    <style name="Theme.ExpenseCategory" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_500</item>
        <item name="android:fontFamily">@font/dosis_bold</item>
        <item name="fontFamily">@font/dosis_bold</item>
    </style>

    <style name="ToolbarTitle.Bold" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/dosis_bold</item>
        <item name="fontFamily">@font/dosis_bold</item>
    </style>
</resources>